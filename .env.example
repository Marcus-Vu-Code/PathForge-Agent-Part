PATHFORGE_PROVIDER_MODE=hybrid-gemini-first
PATHFORGE_DATABASE_URL=sqlite:///./pathforge.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507
QWEN_MAX_NEW_TOKENS=1800
QWEN_MAX_INPUT_CHARS=12000
QWEN_DEVICE_MAP=auto
QWEN_TORCH_DTYPE=auto
QWEN_FAST_BACKGROUND_EXTRACTION=true
LOCAL_MODEL_BASE_URL=http://localhost:8080
LOCAL_MODEL_TIMEOUT_SECONDS=12
PATHFORGE_ENABLE_OPENAI_FALLBACK=true
PATHFORGE_MAX_UPLOAD_BYTES=2000000

